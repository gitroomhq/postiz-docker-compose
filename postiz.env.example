# Optional machine-local Postiz settings.
# Copy this file to postiz.env and keep the real file out of Git.
# Never commit live provider credentials.

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Compose URL and host-port overrides are supplied through the shell or a
# Compose --env-file. The tracked defaults preserve this checkout's behavior.
POSTIZ_MAIN_URL=https://postiz.telekvirtualreality.com
POSTIZ_FRONTEND_URL=https://postiz.telekvirtualreality.com
POSTIZ_BACKEND_URL=https://postiz.telekvirtualreality.com/api
POSTIZ_HOST_PORT=4007
